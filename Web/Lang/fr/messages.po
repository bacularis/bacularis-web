msgstr "Sélectionnez le client de sauvegarde et choisissez comment parcourir les fichiers pour la restauration."

msgid "Step 1 - select restore source and browser mode"
msgstr "Étape 1 – sélectionner la source de restauration et le mode de navigation"

msgid "Help me choose"
msgstr "Aidez-moi à choisir"

